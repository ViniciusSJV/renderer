         }
@@ -82,6 +85,10 @@ pub fn validate_fact_ids(facts: &[Fact]) -> Result<(), String> {
     let mut seen = HashSet::new();
 
     for fact in facts {
+        let outcome = fact.validate();
+        if !outcome.ok {
+            return Err(outcome.reason.unwrap_or_default());
+        }
