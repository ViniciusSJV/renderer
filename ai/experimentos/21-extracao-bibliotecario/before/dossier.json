        "        summary.min_ns,",
        "        summary.median_ns,",
        "        summary.max_ns,",
        "    );",
        "",
        "    for (index, sample_ns) in summary.samples.iter().enumerate() {",
        "        println!(\"sample_{}={}ns\", index, sample_ns);",
        "    }",
        "}"
